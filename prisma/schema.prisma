generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

// Схема знята з живої MySQL `parta` (VPS diesel). Не ганяти стару snake-case міграцію.

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Achievement {
  id                 String               @id
  title              String
  description        String               @db.Text
  category           String
  icon               String
  hidden             Boolean              @default(false)
  StudentAchievement StudentAchievement[]
}

model BackpackItem {
  id       String  @id
  title    String
  category String
  icon     String
  unlocked Boolean @default(false)
}

model ChatMessage {
  id                                 String    @id
  classId                            String
  schoolId                           String
  kind                               String
  senderId                           String
  recipientId                        String?
  text                               String    @db.Text
  createdAt                          DateTime  @default(now())
  ClassRoom                          ClassRoom @relation(fields: [classId], references: [id])
  User_ChatMessage_recipientIdToUser User?     @relation("ChatMessage_recipientIdToUser", fields: [recipientId], references: [id])
  School                             School    @relation(fields: [schoolId], references: [id])
  User_ChatMessage_senderIdToUser    User      @relation("ChatMessage_senderIdToUser", fields: [senderId], references: [id])

  @@index([classId, kind])
  @@index([recipientId])
  @@index([schoolId], map: "ChatMessage_schoolId_fkey")
  @@index([senderId])
}

model ClassEvent {
  id              String    @id
  classId         String
  title           String
  description     String    @db.Text
  date            DateTime?
  startsAt        DateTime
  endsAt          DateTime
  participantIds  Json
  progress        Int       @default(0)
  materials       Json
  reviewComment   String?   @db.Text
  reviewedAt      DateTime?
  publishedPostId String?
  ClassRoom       ClassRoom @relation(fields: [classId], references: [id])

  @@index([classId])
}

model ClassMembership {
  id        String    @id
  classId   String
  studentId String
  joinedAt  DateTime  @default(now())
  ClassRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  User      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
}

model ClassRoom {
  id                             String             @id
  schoolId                       String
  name                           String
  grade                          Int
  teacherId                      String
  inviteCode                     String             @unique
  goalTargetXp                   Int                @default(1000)
  goalCurrentXp                  Int                @default(0)
  goalTitle                      String             @default("Разом збираємо 1000 XP")
  ChatMessage                    ChatMessage[]
  ClassEvent                     ClassEvent[]
  ClassMembership                ClassMembership[]
  School                         School             @relation(fields: [schoolId], references: [id])
  User_ClassRoom_teacherIdToUser User               @relation("ClassRoom_teacherIdToUser", fields: [teacherId], references: [id])
  Homework                       Homework[]
  LearningMaterial               LearningMaterial[]
  Post                           Post[]
  Quest                          Quest[]
  Quiz                           Quiz[]
  LessonSlot                     LessonSlot[]
  PeriodicTask                   PeriodicTask[]
  User_User_classIdToClassRoom   User[]             @relation("User_classIdToClassRoom")

  @@index([schoolId], map: "ClassRoom_schoolId_fkey")
  @@index([teacherId], map: "ClassRoom_teacherId_fkey")
}

model Homework {
  id                 String               @id
  classId            String
  subject            String
  title              String
  description        String               @db.Text
  dueDate            DateTime
  startsAt           DateTime
  endsAt             DateTime
  xpReward           Int
  createdBy          String
  linkedQuizId       String?
  ClassRoom          ClassRoom            @relation(fields: [classId], references: [id])
  User               User                 @relation(fields: [createdBy], references: [id])
  HomeworkSubmission HomeworkSubmission[]

  @@index([classId])
  @@index([createdBy], map: "Homework_createdBy_fkey")
}

model HomeworkSubmission {
  id             String    @id
  homeworkId     String
  studentId      String
  status         String
  answer         String?   @db.Text
  teacherComment String?   @db.Text
  submittedAt    DateTime?
  reviewedAt     DateTime?
  Homework       Homework  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  User           User      @relation(fields: [studentId], references: [id])

  @@unique([homeworkId, studentId])
  @@index([studentId])
}

model LearningMaterial {
  id           String    @id
  classId      String
  subject      String
  title        String
  summary      String    @db.Text
  missedLesson Boolean   @default(false)
  ClassRoom    ClassRoom @relation(fields: [classId], references: [id])

  @@index([classId])
}

model NavSeen {
  id      String   @id
  userId  String
  section String
  seenAt  DateTime @default(now())
  User    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, section])
}

model Notification {
  id        String   @id
  userId    String
  title     String
  body      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  type      String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Post {
  id         String    @id
  authorId   String
  classId    String
  schoolId   String
  text       String    @db.Text
  imageEmoji String?
  category   String?
  status     String
  pinned     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  reactions  Json
  User       User      @relation(fields: [authorId], references: [id])
  ClassRoom  ClassRoom @relation(fields: [classId], references: [id])
  School     School    @relation(fields: [schoolId], references: [id])

  @@index([authorId])
  @@index([classId, status])
  @@index([schoolId], map: "Post_schoolId_fkey")
}

model LessonSlot {
  id           String    @id
  classId      String
  dayOfWeek    Int
  period       Int
  startsAtTime String
  endsAtTime   String
  subject      String
  room         String?
  teacherNote  String?   @db.Text
  ClassRoom    ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, dayOfWeek, period])
  @@index([classId, dayOfWeek])
}

model PeriodicTask {
  id          String                   @id
  classId     String
  cadence     String
  title       String
  description String                   @db.Text
  xpReward    Int
  active      Boolean                  @default(true)
  createdBy   String
  createdAt   DateTime                 @default(now())
  ClassRoom   ClassRoom                @relation(fields: [classId], references: [id], onDelete: Cascade)
  Completions PeriodicTaskCompletion[]

  @@index([classId, cadence])
}

model PeriodicTaskCompletion {
  id          String       @id
  taskId      String
  userId      String
  periodKey   String
  completedAt DateTime     @default(now())
  PeriodicTask PeriodicTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  User        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId, periodKey])
  @@index([userId])
}

model Quest {
  id             String          @id
  classId        String
  title          String
  description    String          @db.Text
  illustration   String
  xpReward       Int
  totalSteps     Int
  questions      Json?
  questionSource String?
  ClassRoom      ClassRoom       @relation(fields: [classId], references: [id])
  QuestProgress  QuestProgress[]

  @@index([classId])
}

model QuestProgress {
  id          String  @id
  questId     String
  studentId   String
  currentStep Int     @default(0)
  completed   Boolean @default(false)
  Quest       Quest   @relation(fields: [questId], references: [id], onDelete: Cascade)
  User        User    @relation(fields: [studentId], references: [id])

  @@unique([questId, studentId])
  @@index([studentId], map: "QuestProgress_studentId_fkey")
}

model Quiz {
  id          String        @id
  classId     String
  subject     String
  title       String
  xpReward    Int
  questions   Json
  templateId  String?
  ClassRoom   ClassRoom     @relation(fields: [classId], references: [id])
  QuizAttempt QuizAttempt[]

  @@index([classId])
}

model QuizAttempt {
  id          String   @id
  quizId      String
  studentId   String
  answers     Json
  score       Int
  total       Int
  xpEarned    Int
  completedAt DateTime @default(now())
  Quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  User        User     @relation(fields: [studentId], references: [id])

  @@index([quizId, studentId])
  @@index([studentId])
}

model QuizTemplate {
  id          String @id
  subject     String
  title       String
  description String @db.Text
  xpReward    Int
  questions   Json
}

model School {
  id          String        @id
  name        String
  ChatMessage ChatMessage[]
  ClassRoom   ClassRoom[]
  Post        Post[]
  User        User[]
}

model StudentAchievement {
  id            String      @id
  studentId     String
  achievementId String
  unlockedAt    DateTime    @default(now())
  Achievement   Achievement @relation(fields: [achievementId], references: [id])
  User          User        @relation(fields: [studentId], references: [id])

  @@unique([studentId, achievementId])
  @@index([achievementId], map: "StudentAchievement_achievementId_fkey")
}

model StudentProfile {
  userId              String  @id
  level               Int     @default(1)
  xp                  Int     @default(0)
  xpToNextLevel       Int     @default(1000)
  unlockedItems       Json
  onboardingCompleted Boolean @default(false)
  User                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                                        String               @id
  email                                     String               @unique
  passwordHash                              String
  role                                      String
  firstName                                 String
  lastName                                  String
  displayName                               String
  schoolId                                  String
  classId                                   String?
  avatarColor                               String
  avatarEmoji                               String
  ChatMessage_ChatMessage_recipientIdToUser ChatMessage[]        @relation("ChatMessage_recipientIdToUser")
  ChatMessage_ChatMessage_senderIdToUser    ChatMessage[]        @relation("ChatMessage_senderIdToUser")
  ClassMembership                           ClassMembership[]
  ClassRoom_ClassRoom_teacherIdToUser       ClassRoom[]          @relation("ClassRoom_teacherIdToUser")
  Homework                                  Homework[]
  HomeworkSubmission                        HomeworkSubmission[]
  NavSeen                                   NavSeen[]
  Notification                              Notification[]
  Post                                      Post[]
  QuestProgress                             QuestProgress[]
  QuizAttempt                               QuizAttempt[]
  StudentAchievement                        StudentAchievement[]
  StudentProfile                            StudentProfile?
  PeriodicTaskCompletion                    PeriodicTaskCompletion[]
  ClassRoom_User_classIdToClassRoom         ClassRoom?           @relation("User_classIdToClassRoom", fields: [classId], references: [id])
  School                                    School               @relation(fields: [schoolId], references: [id])
  XpTransaction                             XpTransaction[]

  @@index([classId], map: "User_classId_fkey")
  @@index([schoolId], map: "User_schoolId_fkey")
}

model XpTransaction {
  id        String   @id
  studentId String
  amount    Int
  reason    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}
