generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model School {
  id      String      @id
  name    String
  users   User[]
  classes ClassRoom[]
  posts   Post[]
  chats   ChatMessage[]
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  role         String
  firstName    String
  lastName     String
  displayName  String
  schoolId     String
  classId      String?
  avatarColor  String
  avatarEmoji  String

  school              School               @relation(fields: [schoolId], references: [id])
  classRoom           ClassRoom?           @relation("UserClass", fields: [classId], references: [id])
  taughtClasses       ClassRoom[]          @relation("TeacherClasses")
  memberships         ClassMembership[]
  studentProfile      StudentProfile?
  posts               Post[]
  homeworksCreated    Homework[]           @relation("HomeworkCreator")
  homeworkSubmissions HomeworkSubmission[]
  quizAttempts        QuizAttempt[]
  questProgress       QuestProgress[]
  studentAchievements StudentAchievement[]
  notifications       Notification[]
  xpTransactions      XpTransaction[]
  chatSent            ChatMessage[]        @relation("ChatSender")
  chatReceived        ChatMessage[]        @relation("ChatRecipient")
  navSeen             NavSeen[]
}

model ClassRoom {
  id             String @id
  schoolId       String
  name           String
  grade          Int
  teacherId      String
  inviteCode     String @unique
  goalTargetXp   Int    @default(1000)
  goalCurrentXp  Int    @default(0)
  goalTitle      String @default("Разом збираємо 1000 XP")

  school            School             @relation(fields: [schoolId], references: [id])
  teacher           User               @relation("TeacherClasses", fields: [teacherId], references: [id])
  members           ClassMembership[]
  users             User[]             @relation("UserClass")
  posts             Post[]
  homeworks         Homework[]
  quizzes           Quiz[]
  quests            Quest[]
  events            ClassEvent[]
  learningMaterials LearningMaterial[]
  chatMessages      ChatMessage[]
}

model ClassMembership {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  joinedAt  DateTime @default(now())

  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
}

model StudentProfile {
  userId              String  @id
  level               Int     @default(1)
  xp                  Int     @default(0)
  xpToNextLevel       Int     @default(1000)
  unlockedItems       Json
  onboardingCompleted Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id         String   @id
  authorId   String
  classId    String
  schoolId   String
  text       String   @db.Text
  imageEmoji String?
  category   String?
  status     String
  createdAt  DateTime @default(now())
  reactions  Json

  author User      @relation(fields: [authorId], references: [id])
  class  ClassRoom @relation(fields: [classId], references: [id])
  school School    @relation(fields: [schoolId], references: [id])

  @@index([classId, status])
  @@index([authorId])
}

model Homework {
  id           String   @id
  classId      String
  subject      String
  title        String
  description  String   @db.Text
  dueDate      DateTime
  startsAt     DateTime
  endsAt       DateTime
  xpReward     Int
  createdBy    String
  linkedQuizId String?

  class       ClassRoom             @relation(fields: [classId], references: [id])
  creator     User                  @relation("HomeworkCreator", fields: [createdBy], references: [id])
  submissions HomeworkSubmission[]

  @@index([classId])
}

model HomeworkSubmission {
  id             String    @id
  homeworkId     String
  studentId      String
  status         String
  answer         String?   @db.Text
  teacherComment String?   @db.Text
  submittedAt    DateTime?
  reviewedAt     DateTime?

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  User     @relation(fields: [studentId], references: [id])

  @@unique([homeworkId, studentId])
  @@index([studentId])
}

model QuizTemplate {
  id          String @id
  subject     String
  title       String
  description String @db.Text
  xpReward    Int
  questions   Json
}

model Quiz {
  id         String  @id
  classId    String
  subject    String
  title      String
  xpReward   Int
  questions  Json
  templateId String?

  class    ClassRoom     @relation(fields: [classId], references: [id])
  attempts QuizAttempt[]

  @@index([classId])
}

model QuizAttempt {
  id          String   @id
  quizId      String
  studentId   String
  answers     Json
  score       Int
  total       Int
  xpEarned    Int
  completedAt DateTime @default(now())

  quiz    Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id])

  @@index([quizId, studentId])
  @@index([studentId])
}

model Quest {
  id             String  @id
  classId        String
  title          String
  description    String  @db.Text
  illustration   String
  xpReward       Int
  totalSteps     Int
  questions      Json?
  questionSource String?

  class    ClassRoom       @relation(fields: [classId], references: [id])
  progress QuestProgress[]

  @@index([classId])
}

model QuestProgress {
  id          String  @id @default(cuid())
  questId     String
  studentId   String
  currentStep Int     @default(0)
  completed   Boolean @default(false)

  quest   Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id])

  @@unique([questId, studentId])
}

model Achievement {
  id          String @id
  title       String
  description String @db.Text
  category    String
  icon        String
  hidden      Boolean @default(false)

  students StudentAchievement[]
}

model StudentAchievement {
  id            String   @id @default(cuid())
  studentId     String
  achievementId String
  unlockedAt    DateTime @default(now())

  student     User        @relation(fields: [studentId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([studentId, achievementId])
}

model ClassEvent {
  id              String    @id
  classId         String
  title           String
  description     String    @db.Text
  date            DateTime?
  startsAt        DateTime
  endsAt          DateTime
  participantIds  Json
  progress        Int       @default(0)
  materials       Json
  reviewComment   String?   @db.Text
  reviewedAt      DateTime?
  publishedPostId String?

  class ClassRoom @relation(fields: [classId], references: [id])

  @@index([classId])
}

model Notification {
  id        String   @id
  userId    String
  title     String
  body      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  type      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model XpTransaction {
  id        String   @id
  studentId String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model BackpackItem {
  id        String  @id
  title     String
  category  String
  icon      String
  unlocked  Boolean @default(false)
}

model LearningMaterial {
  id           String  @id
  classId      String
  subject      String
  title        String
  summary      String  @db.Text
  missedLesson Boolean @default(false)

  class ClassRoom @relation(fields: [classId], references: [id])

  @@index([classId])
}

model ChatMessage {
  id          String   @id
  classId     String
  schoolId    String
  kind        String
  senderId    String
  recipientId String?
  text        String   @db.Text
  createdAt   DateTime @default(now())

  class     ClassRoom @relation(fields: [classId], references: [id])
  school    School    @relation(fields: [schoolId], references: [id])
  sender    User      @relation("ChatSender", fields: [senderId], references: [id])
  recipient User?     @relation("ChatRecipient", fields: [recipientId], references: [id])

  @@index([classId, kind])
  @@index([senderId])
  @@index([recipientId])
}

model NavSeen {
  id        String   @id @default(cuid())
  userId    String
  section   String
  seenAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, section])
}
